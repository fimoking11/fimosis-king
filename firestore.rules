rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "tu-correo@ejemplo.com"; // cambia por tu correo
    }
    match /months/{month} {
      allow read: if true;
      // Primer voto del mes: crea el contador con 1, junto con el voto del propio usuario
      allow create: if request.auth != null
        && request.resource.data.count == 1
        && existsAfter(/databases/$(database)/documents/months/$(month)/votes/$(request.auth.uid));
      // Resto de votos: suma exactamente 1 y solo si este usuario no había votado
      allow update: if request.auth != null
        && request.resource.data.count == resource.data.count + 1
        && !exists(/databases/$(database)/documents/months/$(month)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/months/$(month)/votes/$(request.auth.uid));

      match /votes/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ts', 'email'])
          && request.resource.data.ts == request.time
          && request.resource.data.email == request.auth.token.email;
      }
    }

    // Cartas: cada usuario solo lee y escribe su propio documento
    function cardIds() { return ['fichaje','poster','tiburon','espaldas','rodillas','silencio','montana-rusa','tortuga','abuela','vagabundo','arespro','patatas','bluelock','cafelito','cocinando','consola','supermercado']; }
    function sameDay(a, b) { return a.year() == b.year() && a.month() == b.month() && a.day() == b.day(); }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Primer sobre
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cards', 'total', 'lastPack'])
        && request.resource.data.total == 5
        && request.resource.data.lastPack == request.time
        && request.resource.data.cards.keys().hasOnly(cardIds());
      // Un sobre por día (día UTC): suma 5 cartas como máximo y solo cartas válidas
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.total == resource.data.total + 5
        && request.resource.data.lastPack == request.time
        && !sameDay(resource.data.lastPack, request.time)
        && request.resource.data.cards.diff(resource.data.cards).affectedKeys().hasOnly(cardIds())
        && request.resource.data.cards.diff(resource.data.cards).affectedKeys().size() <= 5;
    }

    // Perfil: lo lee cualquiera con sesión iniciada y solo lo edita su dueño
    function phraseIds() { return ['p1','p2','p3','p4','p5','p6','p7','p8','p9','p10']; }
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'phrase'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.phrase in phraseIds()
        && (request.resource.data.avatar == ''
            || request.resource.data.avatar in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cards.keys());
    }
  }
}
